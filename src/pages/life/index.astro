---
import { getCollection } from 'astro:content';
import LifeCard from '../../components/LifeCard.astro';
import { site } from '../../data/site';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('life')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title={`Life outside the office — ${site.name}`}
	description="Whatever's keeping me going outside of the office"
>
	<section class="life-hero container">
		<p class="eyebrow">Outside the office</p>
		<h1 class="display">So what else does Nico get up to?</h1>
		<div class="intro">
			<p class="lede">
				Things I personally enjoy that I'd like to share with you.
			</p>
			<span>Personal notes, updated when I feel like it.</span>
		</div>
	</section>

	<section class="entries container" aria-label="Personal stories">
		{entries.map((entry) => <LifeCard entry={entry} />)}
	</section>
</Layout>

<style>
	.life-hero {
		padding-block: clamp(5rem, 12vw, 10rem);
	}

	h1 {
		max-width: 12ch;
		margin: 0;
	}

	.intro {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	.intro p {
		margin: 0;
	}

	.intro span {
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	.entries {
		padding-bottom: var(--section-space);
	}

	@media (max-width: 48rem) {
		.intro {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
