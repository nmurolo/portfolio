---
import { getCollection } from 'astro:content';
import LifeCard from '../../components/LifeCard.astro';
import { site } from '../../data/site';
import Layout from '../../layouts/Layout.astro';

const entries = (await getCollection('life')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title={`Life outside work — ${site.name}`}
	description="Personal notes on language, travel, hobbies, and the interests that shape life outside work."
>
	<section class="life-hero container">
		<p class="eyebrow">Outside work</p>
		<h1 class="display">The things I follow just because they’re interesting.</h1>
		<div class="intro">
			<p class="lede">
				Language, travel, hobbies, and ongoing curiosities live here—separate from the portfolio, but still
				part of the person behind the work.
			</p>
			<span>Personal notes, occasionally updated.</span>
		</div>
	</section>

	<section class="entries container" aria-label="Personal stories">
		{entries.map((entry) => <LifeCard entry={entry} />)}
	</section>

	<section class="invitation container" data-reveal>
		<p class="eyebrow">Room to grow</p>
		<h2>Add another interest whenever it deserves its own page.</h2>
		<p>
			Future entries might cover cooking, photography, books, music, running, or anything else you want to
			remember and share.
		</p>
	</section>
</Layout>

<style>
	.life-hero {
		padding-block: clamp(5rem, 12vw, 10rem);
	}

	h1 {
		max-width: 12ch;
		margin: 0;
	}

	.intro {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	.intro p {
		margin: 0;
	}

	.intro span {
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	.entries {
		padding-bottom: var(--section-space);
	}

	.invitation {
		display: grid;
		grid-template-columns: 0.5fr 1fr 0.7fr;
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: var(--section-space);
		border-top: 1px solid var(--line);
	}

	.invitation h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
	}

	.invitation > p:last-child {
		margin: 0;
		color: var(--text-muted);
	}

	@media (max-width: 48rem) {
		.intro {
			align-items: flex-start;
			flex-direction: column;
		}

		.invitation {
			grid-template-columns: 1fr;
		}
	}
</style>
