---
import ContactCta from '../components/ContactCta.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`About — ${site.name}`} description={`Learn about ${site.name}'s approach, capabilities, and experience.`}>
	<section class="page-hero container">
		<p class="eyebrow">About</p>
		<h1 class="display">Thoughtful work starts with curiosity.</h1>
	</section>

	<section class="intro container" data-reveal>
		<div class="intro-copy">
			<p class="lead">{site.profile.bio}</p>
			<p>
				I enjoy working closely with people who care about what they make. Together, we turn early ideas
				into clear systems and finished experiences—balancing ambition with the practical details needed
				to bring good work into the world.
			</p>
			<p>
				This is placeholder copy. Replace it with your own background, point of view, and the kinds of
				collaborations you are looking for.
			</p>
		</div>
		<img src="/images/profile-placeholder.svg" alt="Abstract portrait placeholder" />
	</section>

	<section class="section container">
		<div class="capabilities">
			<header>
				<p class="eyebrow">Capabilities</p>
				<h2>A flexible practice, shaped around the problem.</h2>
			</header>
			<div class="capability-list">
				{site.profile.services.map((service, index) => (
					<div data-reveal>
						<span>0{index + 1}</span>
						<h3>{service}</h3>
						<p>Strategy, exploration, prototyping, and a practical system your team can continue to use.</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="facts">
		<div class="container facts-grid">
			<div>
				<p class="eyebrow">Currently</p>
				<p>{site.availability}</p>
			</div>
			<div>
				<p class="eyebrow">Location</p>
				<p>{site.location}</p>
			</div>
			<div>
				<p class="eyebrow">Best fit</p>
				<p>Products and identities with a clear point of view.</p>
			</div>
		</div>
	</section>

	<div class="section container">
		<ContactCta compact />
	</div>
</Layout>

<style>
	.page-hero {
		padding-block: clamp(5rem, 13vw, 11rem);
	}

	h1 {
		max-width: 11ch;
		margin: 0;
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1.2fr);
		gap: clamp(3rem, 10vw, 10rem);
		align-items: start;
		padding-bottom: var(--section-space);
	}

	.intro img {
		width: 100%;
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-md);
		object-fit: cover;
	}

	.intro-copy {
		padding-top: 2rem;
	}

	.intro-copy p {
		color: var(--text-muted);
	}

	.intro-copy .lead {
		color: var(--text);
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		letter-spacing: -0.035em;
		line-height: 1.15;
	}

	.capabilities {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(3rem, 10vw, 10rem);
	}

	.capabilities h2 {
		max-width: 10ch;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
	}

	.capability-list > div {
		display: grid;
		grid-template-columns: 2rem minmax(9rem, 0.7fr) 1fr;
		gap: 1rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
	}

	.capability-list span {
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.capability-list h3,
	.capability-list p {
		margin: 0;
	}

	.capability-list h3 {
		font-size: 1rem;
		letter-spacing: -0.02em;
		line-height: 1.5;
	}

	.capability-list p {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.facts {
		padding-block: 3rem;
		background: var(--surface);
	}

	.facts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.facts-grid p:last-child {
		margin: 0;
	}

	@media (max-width: 48rem) {
		.intro,
		.capabilities,
		.facts-grid {
			grid-template-columns: 1fr;
		}

		.intro img {
			order: -1;
		}

		.capability-list > div {
			grid-template-columns: 2rem 1fr;
		}

		.capability-list p {
			grid-column: 2;
		}
	}
</style>
