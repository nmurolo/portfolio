---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'life'>;
}

const { entry } = Astro.props;
const { title, summary, category, cover, accent } = entry.data;
---

<article class:list={['life-card', { 'has-cover': Boolean(cover) }]} data-reveal style={`--life-accent: ${accent}`}>
	{cover && (
		<a class="image" href={`/life/${entry.id}/`}>
			<img src={cover.src} alt={cover.alt} loading="lazy" />
		</a>
	)}
	<div class="copy">
		<p>{category}</p>
		<h2><a href={`/life/${entry.id}/`}>{title}</a></h2>
		{summary && <span>{summary}</span>}
		<a class="read" href={`/life/${entry.id}/`}>Read the story ↗</a>
	</div>
</article>

<style>
	.life-card {
		display: grid;
		gap: clamp(2rem, 7vw, 6rem);
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-top: 1px solid var(--line);
	}

	.life-card.has-cover {
		grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
	}

	.image {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--life-accent) 18%, var(--surface));
	}

	img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 700ms var(--ease);
	}

	.image:hover img {
		transform: scale(1.025);
	}

	.copy > p {
		margin-bottom: 1rem;
		color: var(--life-accent);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h2 {
		margin-bottom: 1.25rem;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 4.6rem);
		font-weight: 400;
	}

	h2 a {
		text-decoration: none;
	}

	.copy > span {
		display: block;
		margin-bottom: 2rem;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.read {
		color: var(--text);
		font-size: 0.82rem;
		font-weight: 700;
	}

	@media (max-width: 48rem) {
		.life-card {
			grid-template-columns: 1fr;
		}
	}
</style>
