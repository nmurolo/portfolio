---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'life'>;
}

const { entry } = Astro.props;
const { title, summary, category, cover, accent } = entry.data;
---

<article class="life-card" data-reveal style={`--life-accent: ${accent}`}>
	<a class="image" href={`/life/${entry.id}/`}>
		{cover ? (
			<img src={cover.src} alt={cover.alt} loading="lazy" />
		) : (
			<span class="image-placeholder" role="img" aria-label="Image placeholder">
				<span>Add an image</span>
			</span>
		)}
	</a>
	<div class="copy">
		<p>{category}</p>
		<h2><a href={`/life/${entry.id}/`}>{title}</a></h2>
		<span>{summary}</span>
		<a class="read" href={`/life/${entry.id}/`}>Read the story ↗</a>
	</div>
</article>

<style>
	.life-card {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-top: 1px solid var(--line);
	}

	.image {
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--life-accent) 18%, var(--surface));
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms var(--ease);
	}

	.image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		background: var(--surface-soft);
		color: var(--text-muted);
	}

	.image-placeholder span {
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.image:hover img {
		transform: scale(1.025);
	}

	.copy > p {
		margin-bottom: 1rem;
		color: var(--life-accent);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h2 {
		margin-bottom: 1.25rem;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 5vw, 4.6rem);
		font-weight: 400;
	}

	h2 a {
		text-decoration: none;
	}

	.copy > span {
		display: block;
		margin-bottom: 2rem;
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.read {
		color: var(--text);
		font-size: 0.82rem;
		font-weight: 700;
	}

	@media (max-width: 48rem) {
		.life-card {
			grid-template-columns: 1fr;
		}
	}
</style>
