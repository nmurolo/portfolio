---
import { site } from '../data/site';

interface Props {
	size?: 'default' | 'large';
}

const { size = 'default' } = Astro.props;
---

<section class:list={['conversation-cta', { large: size === 'large' }]} data-reveal>
	<div class="cta-copy">
		<p class="eyebrow">Start a conversation</p>
		<h2>Let’s build.</h2>
	</div>
	<div class="cta-action">
		<p>{site.availability}</p>
		<div class="cta-links">
			<a class="button button--accent" href={site.summary.href} download={site.summary.filename}>
				{site.summary.label}
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
				</svg>
			</a>
			<a class="button" href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>

<style>
	.conversation-cta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: end;
		padding: clamp(1.6rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
		border-radius: var(--radius-lg);
		background: var(--accent-soft);
	}

	.large {
		padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.75rem, 5vw, 4.5rem);
	}

	.cta-copy {
		min-width: 0;
	}

	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 8vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -0.06em;
		line-height: 1;
		white-space: nowrap;
	}

	.large h2 {
		font-size: clamp(4.5rem, 11vw, 9rem);
	}

	.cta-action {
		display: grid;
		justify-items: end;
		gap: 1rem;
		text-align: right;
	}

	.cta-action p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.cta-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.75rem;
	}

	@media (max-width: 48rem) {
		.conversation-cta {
			grid-template-columns: minmax(0, 1fr);
		}

		h2,
		.large h2 {
			font-size: clamp(2.6rem, 14vw, 4.25rem);
			line-height: 0.95;
			white-space: normal;
			overflow-wrap: break-word;
		}

		.cta-action {
			justify-items: start;
			text-align: left;
		}

		.cta-links {
			justify-content: flex-start;
		}
	}
</style>
