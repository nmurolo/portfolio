---
import ConversationCta from './ConversationCta.astro';
import { site } from '../data/site';

interface Props {
	cta?: boolean;
}

const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		{cta && <ConversationCta />}
		<div class="footer-meta">
			<p>© {year} {site.name}</p>
			<nav aria-label="Social links">
				{site.socials.map((social) => (
					<a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>
				))}
			</nav>
			<a href="#top">Back to top ↑</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
	}

	.footer-meta {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 2rem;
		margin-top: 1.25rem;
		padding-top: 1.1rem;
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	.footer-meta:first-child {
		margin-top: 0;
		padding-top: 0;
	}

	.footer-meta p {
		margin: 0;
	}

	.footer-meta nav {
		display: flex;
		gap: 1.2rem;
	}

	@media (max-width: 48rem) {
		.footer-meta {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.footer-meta nav {
			flex-wrap: wrap;
		}
	}
</style>
