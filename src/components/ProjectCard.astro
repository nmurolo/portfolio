---
import type { CollectionEntry } from 'astro:content';
import { projectCardTags } from '../lib/projects';

interface Props {
	project: CollectionEntry<'projects'>;
	index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, summary, year, cover, accent, featured } = project.data;
const feature = typeof featured === 'object' ? featured : {};
const displayTitle = feature.title ?? title ?? project.id;
const featureSummary = feature.summary ?? summary;
const featureCover = feature.cover ?? cover;
const tags = projectCardTags(project.data);
---

<article class:list={['project-card', { 'has-cover': Boolean(featureCover) }]} data-reveal style={`--card-accent: ${accent}; --delay: ${index * 70}ms`}>
	{featureCover && (
		<a class="project-image" href={`/projects/${project.id}/`} aria-label={`View ${displayTitle} case study`}>
			<img src={featureCover.src} alt={featureCover.alt} loading={index > 0 ? 'lazy' : 'eager'} />
			<span class="view-project" aria-hidden="true">View project ↗</span>
		</a>
	)}
	<div class="project-meta">
		<div>
			{feature.label && <span class="feature-label">{feature.label}</span>}
			<h3><a href={`/projects/${project.id}/`}>{displayTitle}</a></h3>
			{featureSummary && <p>{featureSummary}</p>}
		</div>
		{(year || tags) && (
			<div class="details">
				{year && <span>{year}</span>}
				{tags && <span>{tags}</span>}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		transition-delay: var(--delay);
	}

	.project-image {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--card-accent) 20%, var(--surface));
	}

	.project-image img {
		width: 100%;
		height: auto;
		display: block;
		transition: transform 700ms var(--ease);
	}

	.project-image:hover img {
		transform: scale(1.025);
	}

	.view-project {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.7rem 0.9rem;
		border-radius: 999px;
		background: rgba(15, 15, 17, 0.84);
		color: #fff;
		font-size: 0.76rem;
		font-weight: 700;
		opacity: 0;
		transform: translateY(0.5rem);
		transition:
			opacity 250ms ease,
			transform 250ms var(--ease);
		backdrop-filter: blur(0.5rem);
	}

	.project-image:hover .view-project {
		opacity: 1;
		transform: none;
	}

	.project-meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
	}

	.has-cover .project-meta {
		padding-top: 1.35rem;
	}

	h3 {
		margin-bottom: 0.6rem;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 4vw, 2.7rem);
		font-weight: 400;
	}

	.feature-label {
		display: block;
		margin-bottom: 0.65rem;
		color: var(--accent-strong);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h3 a {
		text-decoration: none;
	}

	p {
		max-width: 42rem;
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.details {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		color: var(--text-muted);
		font-size: 0.74rem;
		text-align: right;
	}

	@media (max-width: 38rem) {
		.project-meta {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.details {
			align-items: flex-start;
			text-align: left;
		}

		.view-project {
			display: none;
		}
	}
</style>
